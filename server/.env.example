# ===== Server =====
PORT=4000
NODE_ENV=development

# SQLite khi phát triển (đường dẫn tính từ thư mục prisma/).
# PostgreSQL khi triển khai, ví dụ: postgresql://user:pass@host:5432/khbd?schema=public
DATABASE_URL="file:./dev.db"

# Chuỗi bí mật ký JWT — BẮT BUỘC, tối thiểu 32 ký tự ngẫu nhiên.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Thời hạn phiên đăng nhập (số ngày).
SESSION_DAYS=7

# ===== Cookie =====
# Cùng domain (khuyên dùng): lax. Frontend và API khác domain: none (bắt buộc COOKIE_SECURE=true, chạy HTTPS).
COOKIE_SAMESITE=lax
# true khi chạy HTTPS. Để trống = tự bật khi NODE_ENV=production.
COOKIE_SECURE=

# ===== CORS =====
# Chỉ cần khi frontend chạy ở domain khác API. Nhiều domain cách nhau bởi dấu phẩy.
CLIENT_ORIGIN=

# Đặt 1 (hoặc số proxy) khi chạy sau Nginx / Render / Railway để lấy đúng IP người dùng cho rate limit.
TRUST_PROXY=

# true: server phục vụ luôn bản build frontend (../dist) — triển khai 1 cổng duy nhất.
SERVE_CLIENT=false

# ===== Chống dò mật khẩu =====
# Số lần đăng nhập sai tối đa cho một tài khoản / một IP trong LOGIN_WINDOW_MINUTES phút.
LOGIN_MAX_FAILS_PER_ACCOUNT=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Số tài khoản tối đa được tạo từ một IP mỗi giờ.
REGISTER_MAX_PER_HOUR=10

# ===== Tài khoản quản trị đầu tiên (npm run db:seed) =====
# Tên đăng nhập đã tồn tại → chỉ nâng quyền lên ADMIN (giữ mật khẩu cũ, trừ khi ADMIN_RESET_PASSWORD=true).
# Chưa tồn tại → tạo mới, cần đủ 4 trường. Nên xóa ADMIN_PASSWORD khỏi .env sau khi tạo xong.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_RESET_PASSWORD=false

# ===== Nạp điểm bằng chuyển khoản (VietQR) =====
# BANK_ID: mã BIN hoặc tên viết tắt theo https://api.vietqr.io/v2/banks (VD: 970436 hoặc vietcombank)
BANK_ID=
BANK_NAME=Vietcombank
BANK_ACCOUNT_NO=
# Tên chủ tài khoản, viết HOA không dấu như trên app ngân hàng
BANK_ACCOUNT_NAME=
# Mẫu ảnh QR: compact, compact2, qr_only, print
VIETQR_TEMPLATE=compact2

# ===== Tự động duyệt nạp điểm qua webhook ngân hàng (SePay) =====
# MB Bank: BANK_ID=970422 (hoặc mbbank), BANK_NAME=MB Bank.
# Để trống = tắt, admin duyệt tay như cũ. Bật: tạo chuỗi ngẫu nhiên ≥ 24 ký tự, VD:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# rồi dán CÙNG chuỗi đó vào SePay → Webhooks → Kiểu chứng thực "API Key".
# URL webhook: https://<domain-của-bạn>/api/webhooks/sepay
SEPAY_WEBHOOK_API_KEY=f83ee3bb41ce77f11ae1780d878574e7ce08bf1550bbbc98  
