{
  "name": "lich-bao-giang-server",
  "private": true,
  "version": "1.0.0",
  "description": "API tài khoản, điểm và quản trị cho ứng dụng Kế hoạch giảng dạy.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:pg:schema": "node scripts/pg-schema.js",
    "db:pg:deploy": "npm run db:pg:schema && prisma generate --schema prisma/postgres/schema.prisma && npm run db:pg:unfail && prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:pg:unfail": "prisma migrate resolve --rolled-back 20260926034950_sepay_bank_transactions --schema prisma/postgres/schema.prisma || echo \"(bo qua: migration khong o trang thai failed)\"",
    "db:studio": "prisma studio",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "topup": "node --env-file-if-exists=.env scripts/topup.js",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:seed-demo": "node --env-file-if-exists=.env prisma/seed-demo.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "bcrypt@6.0.0": true
  }
}
