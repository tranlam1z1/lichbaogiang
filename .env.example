# Biến môi trường cho FRONTEND (đọc lúc `npm run build`). Không có bí mật nào ở đây —
# mọi giá trị VITE_* đều bị nhúng vào file JS công khai, TUYỆT ĐỐI không đặt mật khẩu/khóa vào.
# Biến của BACKEND nằm ở server/.env.example.

# Địa chỉ API. Để trống = "/api" (frontend và backend chung một domain — cách triển khai khuyên dùng, như Render).
# Chỉ đặt khi API ở domain khác, VD: https://api.ten-mien-cua-ban.vn/api
VITE_API_URL=

# Thư mục con khi web không nằm ở gốc domain, VD: /khbd/. Để trống = "/".
VITE_BASE=

# Chỉ dùng khi chạy dev: backend local để Vite chuyển tiếp /api (mặc định http://localhost:4000).
VITE_API_PROXY=

# Nút "Hỗ trợ qua Zalo" ở góc dưới bên phải. Để trống VITE_ZALO_PHONE = không hiện nút.
# Số điện thoại Zalo nhận tin hỗ trợ (VD: 0912345678). Nút mở https://zalo.me/<số>.
VITE_ZALO_PHONE=0961180012
# Giờ hỗ trợ hiện trong ô Zalo, VD: 7:00 – 21:00 hằng ngày. Để trống = không hiện dòng giờ hỗ trợ.
VITE_SUPPORT_HOURS=
